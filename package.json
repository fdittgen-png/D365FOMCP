{
  "name": "tis-mcpd365fo",
  "version": "1.0.0",
  "description": "D365FO MCP Services — Knowledge Base + Cross-Reference + Security + Task Recorder",
  "type": "module",
  "main": "src/functions/index.js",
  "scripts": {
    "build:kb": "node --env-file-if-exists=.env build/build-kb.js",
    "build:xref": "node --env-file-if-exists=.env --max-old-space-size=8192 build/build-xref-db.js",
    "build:sec": "node --env-file-if-exists=.env build/build-sec.js",
    "build:isv": "node --env-file-if-exists=.env build/isv-scan.js",
    "update:xref": "node --env-file-if-exists=.env build/update-xref-module.js",
    "update:kb": "node --env-file-if-exists=.env build/update-kb-model.js",
    "seed:dq": "node --env-file-if-exists=.env build/seed-dq-rules.js",
    "export:sem": "node --env-file-if-exists=.env build/export-semantic.js",
    "gen:dq": "node --env-file-if-exists=.env build/gen-dq-sql.js",
    "start:kb": "node src/local/mcp-server-kb.js",
    "start:xref": "node src/local/mcp-server-xref.js",
    "start:sec": "node src/local/mcp-server-sec.js",
    "start:taskrecorder": "node src/local/mcp-server-taskrecorder.js",
    "start:wiki": "node src/local/mcp-server-wiki.js",
    "ticket-to-pdf": "node scripts/ticket-xml-to-pdf.js",
    "test": "node --test test/*.test.js test/integration/*.test.js",
    "test:sec": "node --test test/sec-tools.test.js",
    "test:kb": "node --test test/kb-tools.test.js",
    "test:xref": "node --test test/xref-tools.test.js",
    "test:taskrecorder": "node --test test/taskrecorder-parser.test.js",
    "test:isv": "node --test test/isv-parsers.test.js",
    "test:customfields": "node --test test/custom-fields.test.js test/custom-fields-tools.test.js",
    "test:semantic": "node --test test/semantic-store.test.js test/semantic-tools.test.js test/dq-generator.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "start:azure": "func start",
    "gen:plugin-refs": "node build/gen-plugin-tool-refs.js",
    "pack:skills": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Build-SkillsPackage.ps1",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "dependencies": {
    "@azure/functions": "^4.9.0",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.31.0",
    "@modelcontextprotocol/sdk": "1.27.0",
    "adm-zip": "0.5.16",
    "better-sqlite3": "12.8.0",
    "fast-xml-parser": "^5.2.3",
    "html-to-text": "^9.0.5",
    "mammoth": "^1.8.0",
    "pdfkit": "^0.15.0",
    "sql.js": "1.12.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "mssql": "^11.0.0",
    "typescript": "5.9.3"
  }
}

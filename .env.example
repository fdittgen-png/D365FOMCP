# D365FO MCP Services — Local Environment Configuration
#
# Copy this file to `.env` and adjust paths for your machine.
# The `.env` file is gitignored — never commit it.
#
# These variables are read by:
#   - `src/azure/shared.js` (KB / XRef / Sec singletons)
#   - `src/local/mcp-server-{kb,xref,sec}.js` (local stdio servers; CLI arg
#     overrides env var)
#   - `src/azure/initializeDatabases()` (P6-06 startup probe)

# ── Local SQLite database paths ────────────────────────────────────────────
# Build with:
#   npm run build:kb       → ~/.claude/d365fo_kb.sqlite      (~1 GB)
#   npm run build:xref     → ~/.claude/d365fo_xref.sqlite    (~3.3 GB)
#   npm run build:sec      → ~/.claude/d365fo_sec.sqlite     (~60 MB)
KB_DB_PATH=C:\Users\<username>\.claude\d365fo_kb.sqlite
XREF_DB_PATH=C:\Users\<username>\.claude\d365fo_xref.sqlite
SEC_DB_PATH=C:\Users\<username>\.claude\d365fo_sec.sqlite

# ── SoD rules (optional) ──────────────────────────────────────────────────
# Path to a JSON file defining Segregation of Duties rules.
# See examples/sod-rules-sample.json for the expected format.
# Required for sec_sod_check and the SoD portion of sec_what_if.
SOD_RULES_FILE=examples/sod-rules-sample.json

# ── Azure deployment env vars (function host runtime) ─────────────────────
#
# These are NOT used in local dev — they're set by the Function App at deploy
# time. Listed here as documentation so a contributor knows the full env
# surface.
#
#   AzureWebJobsStorage      Azure Storage connection string used by Functions
#                            runtime + the d365sec-upload blob helper. NEVER
#                            commit a real connection string. Set in the
#                            Function App via Azure Portal or Bicep.
#
#   WEBSITE_AUTH_ENABLED     'True' when Easy Auth is enabled (production).
#                            d365sec-upload uses this to require authenticated
#                            uploads in prod. NOT set in local dev.
#
#   WEBSITE_SITE_NAME        Auto-set by Azure Functions. Used for log lines.
#   WEBSITE_OWNER_NAME       Auto-set by Azure Functions. Used to derive the
#                            subscription id for management calls.
#   IDENTITY_ENDPOINT        Auto-set by Azure Functions when System-Assigned
#                            Managed Identity is enabled.
#   IDENTITY_HEADER          Companion header for IDENTITY_ENDPOINT.

# ── OTRS extractor (Function: otrs-extract) ────────────────────────────────
# Read by src/azure/otrs-client.js. Set in production via app settings on
# the Function App. For local dev, fill these in .env.
#
#   OTRS_USERNAME              OTRS generic-interface login (e.g. "wstis")
#   OTRS_PASSWORD              OTRS password — NEVER commit. In prod, set via
#                              `az functionapp config appsettings set` so the
#                              value lives in App Settings, not in source.
#   OTRS_SEARCH_URL            TicketSearch endpoint (full URL).
#   OTRS_GET_URL               TicketGet endpoint (full URL).
#   OTRS_SERVICE_ID            Numeric ID of the OTRS service row. NOT the
#                              human-readable name — OTRS TicketSearch
#                              rejects the name form with a generic
#                              "Authorization failing" error. Look up the
#                              ID in OTRS Admin > Services.
#                              (D365 support at Trelleborg = 798.)
#   OTRS_STATE                 State filter (singular), default "closed successful".
#   OTRS_MIN_RESOLUTION_CHARS  Minimum body length (chars) of an agent-authored
#                              article for a ticket to count as "has resolution".
#                              Default 200. Increase to be stricter about
#                              quality; decrease to admit one-line fixes.
OTRS_USERNAME=wstis
OTRS_PASSWORD=
OTRS_SEARCH_URL=https://trelleborg.managed-otrs.com/otrs/nph-genericinterface.pl/Webservice/TIS_WS/TicketSearch
OTRS_GET_URL=https://trelleborg.managed-otrs.com/otrs/nph-genericinterface.pl/Webservice/TIS_WS/TicketGet
OTRS_SERVICE_ID=798
OTRS_STATE=closed successful
OTRS_MIN_RESOLUTION_CHARS=200

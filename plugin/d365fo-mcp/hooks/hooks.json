{
  "description": "ERP trace capture (ERP-Trace-Capture-TDD WI-15): records the investigation (request as Claude interpreted it, strategy lines, every D365 KB/XRef MCP call with replayable arguments, the conclusion) to ~/.claude/mcp-trace and the trace ingest Function. Never the tool responses, never the user's raw prompt unless nothing else exists. Off switch: enabled=false in ~/.claude/claude-trace.config.json.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trace-capture.mjs\" UserPromptSubmit", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(d365kb|d365xref|claude_ai_D365_KB|claude_ai_D365_xRef)__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trace-capture.mjs\" PreToolUse", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(d365kb|d365xref|claude_ai_D365_KB|claude_ai_D365_xRef)__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trace-capture.mjs\" PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(d365kb|d365xref|claude_ai_D365_KB|claude_ai_D365_xRef)__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trace-capture.mjs\" PostToolUseFailure", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trace-capture.mjs\" Stop", "timeout": 15 }
        ]
      }
    ]
  }
}

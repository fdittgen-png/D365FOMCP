diag*.ps1
.claude/

# Internal role/duty assignment exports. Contain real assignments; keep local-only.
Security roles assignment_*.csv

# Local-only deployment workspace — refactored Deploy.ps1 + npm cache.
# Defaults may contain operator-specific RG / function app / contact info.
# local-deploy/ — the deployment orchestrator IS tracked (it is the only way to
# deploy this project, and an untracked copy meant its fixes lived on one box).
# Only the volatile and machine-specific parts stay ignored.
local-deploy/logs/
local-deploy/.npm-cache/
local-deploy/.npm-cache-hash
local-deploy/skill-workspaces/
local-deploy/skill-zips/
local-deploy/pim-activate.json

# Security DMF data exports — contain real role/user/duty data. Keep local-only;
# never publish to the (public) repo. Feeds build/build-sec.js.
secanalysis*.zip
*.dta.zip

# Skills package build output (rebuild with npm run pack:skills)
dist/

# plugin archives built for the claude.ai upload (rebuild with Compress-Archive on plugin/d365fo-mcp)
local-deploy/*.zip

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fdittgen-png/D365FOMCP/src/trace/contract/trace-record.v1.schema.json",
  "title": "ERP trace record v1",
  "description": "One record of the cross-ERP trace store. Stream `mcp` = a call record (tool, replayable args, how it ended, touched names — never the response). Stream `claude` = the investigation lifecycle (open · step · annotate · close). See docs/ERP-Trace-Capture-TDD.md §5.",
  "type": "object",
  "required": ["id", "contract_version", "stream", "ts", "erp", "mcp", "session_key", "seq", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^(mcp|claude)_[0-9A-HJKMNP-TV-Z]{26}$" },
    "contract_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "stream": { "enum": ["mcp", "claude"] },
    "ts": { "type": "string", "format": "date-time" },
    "erp": {
      "type": "object",
      "required": ["system", "installation_id"],
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/definitions/identifier" },
        "version": { "$ref": "#/definitions/identifier" },
        "build": { "$ref": "#/definitions/identifier" },
        "installation_id": { "$ref": "#/definitions/identifier" }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["service"],
      "additionalProperties": false,
      "properties": {
        "service": { "$ref": "#/definitions/identifier" },
        "version": { "$ref": "#/definitions/identifier" },
        "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "investigation_id": { "$ref": "#/definitions/identifier" },
    "session_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "seq": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["server", "hook"] },

    "tool": {
      "type": "object",
      "required": ["name", "args"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/identifier" },
        "args": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 2000 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "$ref": "#/definitions/identifier" }, "maxItems": 50 },
              { "$ref": "#/definitions/payload_ref" }
            ]
          }
        }
      }
    },
    "launch_seq": { "type": "integer", "minimum": 0 },
    "result": {
      "type": "object",
      "required": ["kind", "bytes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["data", "empty", "not-found", "error", "unfinished"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "has_more": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "array", "items": { "$ref": "#/definitions/identifier" }, "maxItems": 20 }
      }
    },
    "touched": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["table", "field", "edt", "enum", "class", "method", "data_entity", "form", "menu_item", "role", "duty", "privilege", "model", "recording", "other"] },
          "name": { "$ref": "#/definitions/identifier" },
          "owner": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "functional_context": { "$ref": "#/definitions/identifier" },

    "phase": { "enum": ["open", "step", "annotate", "close"] },
    "investigation": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "purpose": { "enum": ["dashboard", "report", "app", "migration_mapping", "dq_rule", "support", "process_analysis", "comparison", "other"] },
        "title": { "$ref": "#/definitions/prose200" }
      }
    },
    "request": {
      "type": "object",
      "required": ["key", "interpreted"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/identifier" },
        "interpreted": { "type": "string", "minLength": 1, "maxLength": 600 },
        "approach": { "type": "string", "maxLength": 400 },
        "source": { "enum": ["interpretation", "declared", "user_prompt"] }
      }
    },
    "expected_entities": { "type": "array", "items": { "$ref": "#/definitions/identifier" }, "maxItems": 20 },
    "entities_from": { "enum": ["declared", "prompt", "functional_context", "vocabulary_match", "none"] },
    "n": { "type": "integer", "minimum": 1 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 400 },
    "expects": { "type": "array", "items": { "$ref": "#/definitions/identifier" }, "maxItems": 20 },
    "entities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["kind", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "kind": { "$ref": "#/definitions/identifier" },
          "name": { "$ref": "#/definitions/identifier" },
          "level": { "enum": ["functional", "logical", "physical"] },
          "functional_entity": { "$ref": "#/definitions/identifier" },
          "role": { "enum": ["source", "target", "related", "excluded"] },
          "counterpart": {
            "type": "object",
            "required": ["erp", "name"],
            "additionalProperties": false,
            "properties": { "erp": { "$ref": "#/definitions/identifier" }, "name": { "$ref": "#/definitions/identifier" } }
          }
        }
      }
    },
    "note": { "type": "string", "maxLength": 300 },
    "conclusion": {
      "type": "object",
      "required": ["summary", "outcome"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 6000 },
        "outcome": { "enum": ["answered", "partial", "abandoned"] },
        "differences": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["aspect", "statement"],
            "additionalProperties": false,
            "properties": {
              "aspect": { "enum": ["structure", "entity", "lifecycle", "process", "other"] },
              "statement": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "calls": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "stream": { "const": "mcp" } } },
      "then": {
        "required": ["tool", "result"],
        "not": { "anyOf": [ { "required": ["phase"] }, { "required": ["request"] }, { "required": ["conclusion"] } ] }
      }
    },
    {
      "if": { "properties": { "stream": { "const": "claude" } } },
      "then": {
        "required": ["investigation_id", "phase", "investigation"],
        "not": { "anyOf": [ { "required": ["tool"] }, { "required": ["result"] }, { "required": ["touched"] } ] }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "open" } }, "required": ["phase"] },
      "then": { "required": ["request", "expected_entities", "entities_from"] }
    },
    {
      "if": { "properties": { "phase": { "const": "step" } }, "required": ["phase"] },
      "then": { "required": ["n", "intent"] }
    },
    {
      "if": { "properties": { "phase": { "const": "annotate" } }, "required": ["phase"] },
      "then": { "required": ["entities"] }
    },
    {
      "if": { "properties": { "phase": { "const": "close" } }, "required": ["phase"] },
      "then": { "required": ["conclusion"] }
    }
  ],
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[%*]?[A-Za-z][A-Za-z0-9_.:/%*-]{0,127}$" },
    "prose200": { "type": "string", "maxLength": 200 },
    "payload_ref": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
